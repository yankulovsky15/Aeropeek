<Window x:Class="Aeropeek.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="540" MinWidth="560" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Border Background="{StaticResource Surface}" BorderBrush="#26374A" BorderThickness="1"
          CornerRadius="14" Margin="16">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="7" Opacity="0.6" Color="#000000"/>
    </Border.Effect>
    <Border.RenderTransform>
      <ScaleTransform CenterX="380" CenterY="270"/>
    </Border.RenderTransform>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_Drag">
        <DockPanel Margin="24,20,16,14">
          <Button DockPanel.Dock="Right" Style="{StaticResource WinBtn}" Width="38" Height="38"
                  Click="Close_Click" ToolTip="Fermer">
            <Path Data="M 0,0 L 11,11 M 11,0 L 0,11" StrokeThickness="1.4"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Border DockPanel.Dock="Left" x:Name="IconPill" Width="38" Height="38" CornerRadius="10"
                  Background="#16223A" Margin="0,0,14,0" VerticalAlignment="Center">
            <Path x:Name="IconPath" Width="20" Height="20" Stretch="Uniform" Fill="Transparent"
                  Stroke="#6BA6F5" StrokeThickness="1.7"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="CmdText" Foreground="{StaticResource Ink3}" FontSize="12"
                       FontFamily="Cascadia Mono, Consolas" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Background="#0A1017" CornerRadius="9" Margin="24,0,24,0"
              BorderBrush="#1C2836" BorderThickness="1">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="16,12">
          <TextBlock x:Name="OutputText" Foreground="#9DB0C4" FontSize="12.5"
                     FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>

      <DockPanel Grid.Row="2" Margin="24,16,24,20">
        <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource Ghost}"
                Height="38" MinWidth="104" Click="Close_Click"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="Spinner" Width="180" Height="4" CornerRadius="2" Background="#16212E"
                  ClipToBounds="True" Visibility="Collapsed" Margin="0,0,14,0">
            <Border x:Name="SpinnerBar" Width="60" Height="4" CornerRadius="2"
                    Background="{StaticResource Accent}" HorizontalAlignment="Left">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            </Border>
          </Border>
          <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" FontSize="12.5"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
