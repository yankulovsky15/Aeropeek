<Window x:Class="Aeropeek.AttributionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

  <Border Background="{StaticResource Surface}" BorderBrush="#26374A" BorderThickness="1"
          CornerRadius="14" Margin="16">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="7" Opacity="0.6" Color="#000000"/>
    </Border.Effect>
    <Border.RenderTransform>
      <ScaleTransform CenterX="310" CenterY="240"/>
    </Border.RenderTransform>

    <StackPanel Margin="26,22,26,20">

      <DockPanel MouseLeftButtonDown="Header_Drag" Background="Transparent">
        <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Background="#0F2A29"
                Margin="0,0,14,0" VerticalAlignment="Center">
          <Path Data="M 3,20 V 4 M 3,20 H 21 M 6.5,16 L 11,9 L 14.5,12.5 L 20,3"
                Width="20" Height="20" Stretch="Uniform" Fill="Transparent"
                Stroke="#2DD4BF" StrokeThickness="1.7"
                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Mesurer un réglage" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}"/>
          <TextBlock x:Name="TweakName" Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <Border Background="#0D1620" CornerRadius="9" Padding="16,14" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock x:Name="StepText" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
          <TextBlock x:Name="HintText" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,7,0,0"/>

          <Border x:Name="Bar" Height="4" CornerRadius="2" Background="#16212E" Margin="0,14,0,0"
                  ClipToBounds="True" Visibility="Collapsed">
            <Border x:Name="BarFill" Height="4" CornerRadius="2" Background="{StaticResource Accent}"
                    HorizontalAlignment="Left" Width="0"/>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="ResultCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0"
              Visibility="Collapsed">
        <StackPanel>
          <UniformGrid Columns="2">
            <StackPanel>
              <TextBlock Text="SANS LE RÉGLAGE" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="BaseText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"
                         FontFamily="Cascadia Mono, Consolas"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="AVEC LE RÉGLAGE" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="TweakedText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"
                         FontFamily="Cascadia Mono, Consolas"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock x:Name="VerdictText" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="VerdictNote" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,7,0,0"/>
        </StackPanel>
      </Border>

      <DockPanel Margin="0,20,0,0">
        <Button DockPanel.Dock="Right" x:Name="BtnPrimary" Content="Commencer"
                Style="{StaticResource Primary}" Height="40" MinWidth="150" Click="Primary_Click"/>
        <Button DockPanel.Dock="Right" x:Name="BtnSecondary" Content="Annuler"
                Style="{StaticResource Ghost}" Height="40" MinWidth="110" Margin="0,0,10,0"
                Click="Secondary_Click"/>
        <TextBlock x:Name="FootNote" Style="{StaticResource Sub}" FontSize="12"
                   Foreground="{StaticResource Ink3}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>

    </StackPanel>
  </Border>
</Window>
