<Window x:Class="Aeropeek.PowerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="640" MinWidth="620" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Border Background="{StaticResource Surface}" BorderBrush="#26374A" BorderThickness="1"
          CornerRadius="14" Margin="16">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="7" Opacity="0.6" Color="#000000"/>
    </Border.Effect>
    <Border.RenderTransform>
      <ScaleTransform CenterX="360" CenterY="320"/>
    </Border.RenderTransform>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- entête, sert aussi de zone de déplacement -->
      <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_Drag">
        <DockPanel Margin="24,20,16,16">
          <Button DockPanel.Dock="Right" Style="{StaticResource WinBtn}" Width="38" Height="38"
                  Click="Close_Click" ToolTip="Fermer">
            <Path Data="M 0,0 L 11,11 M 11,0 L 0,11" StrokeThickness="1.4"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Background="#2B2317"
                  Margin="0,0,14,0" VerticalAlignment="Center">
            <Path Data="M 13,2 L 4,14 H 11 L 10,22 L 19,10 H 12 Z" Width="20" Height="20"
                  Stretch="Uniform" Fill="Transparent" Stroke="#E0A63C" StrokeThickness="1.7"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Power plans" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="PowerSummary" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,14,20">
        <StackPanel>

          <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
              <TextBlock Text="PLANS DISPONIBLES" Style="{StaticResource Kicker}" Margin="20,16,20,2"/>
              <ItemsControl x:Name="PlansList" Margin="0,8,0,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource RowHover}" Padding="20,0" Height="52" CornerRadius="6">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Utiliser" Style="{StaticResource Ghost}"
                                Visibility="{Binding UseVisibility}" Tag="{Binding}" Click="ApplyPlan_Click"
                                VerticalAlignment="Center" MinWidth="92" Margin="10,0,0,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" ToolTip="Delete this plan"
                                Visibility="{Binding DeleteVisibility}" Tag="{Binding}" Click="DeletePlan_Click"
                                VerticalAlignment="Center" Width="36" Height="34" Padding="0" Margin="16,0,0,0">
                          <Path Data="M 4,7 H 20 M 9,7 V 5 H 15 V 7 M 6.5,7 L 7.5,20 H 16.5 L 17.5,7"
                                Width="15" Height="15" Stretch="Uniform" Fill="Transparent"
                                Stroke="#B08088" StrokeThickness="1.6"
                                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="Actif" Visibility="{Binding ActiveVisibility}"
                                   Foreground="{StaticResource Accent}" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="16,0,10,0"/>
                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding DotFill}"
                                VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="14.5" VerticalAlignment="Center"
                                   Foreground="{Binding NameFill}"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border x:Name="CardDupes" Style="{StaticResource CardAction}" Padding="20,18" Visibility="Collapsed">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Nettoyer" Style="{StaticResource Ghost}"
                      Click="CleanDupes_Click" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="110"/>
              <StackPanel>
                <TextBlock Text="Duplicate plans" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="DupesDetail" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource CardAction}" Padding="20,18">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="BtnUltimate" Content="Ajouter"
                      Style="{StaticResource Ghost}" Click="Ultimate_Click"
                      VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="110"/>
              <StackPanel>
                <TextBlock Text="Ultimate Performance plan" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="UltimateDetail" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource CardAction}" Padding="20,18">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="22,0,4,0">
                <ToggleButton x:Name="TglUsb" Style="{StaticResource Switch}" HorizontalAlignment="Center"
                              Click="UsbPower_Click"/>
                <TextBlock x:Name="UsbState" Foreground="{StaticResource Ink2}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Keep USB ports powered" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="UsbDetail" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="20,18" Margin="0">
            <StackPanel>
              <TextBlock Text="What the active plan does" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="PowerFacts" Style="{StaticResource Sub}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <ContentControl x:Name="PowerVeil" Grid.Row="1" Style="{StaticResource ScanVeil}"
                      Content="Reading the plans…"/>
    </Grid>
  </Border>
</Window>
