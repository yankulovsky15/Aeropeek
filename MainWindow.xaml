<Window x:Class="Aeropeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aeropeek"
        Title="Aeropeek" Height="800" Width="1220" MinHeight="640" MinWidth="980"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Barre de titre integree -->
    <Grid Grid.Row="0" Background="{StaticResource Bg}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource WinBtn}" Click="Minimize_Click" ToolTip="Minimize">
          <Path Data="M 0,0 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
        </Button>
        <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Click="Maximize_Click" ToolTip="Maximize">
          <Path x:Name="MaxIcon" Data="M 0,0 H 10 V 10 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/>
        </Button>
        <Button Style="{StaticResource WinBtnClose}" Click="Close_Click" ToolTip="Close">
          <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
        </Button>
      </StackPanel>
    </Grid>

  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <Border x:Name="Sidebar" Grid.Column="0" Width="238"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="12,14,12,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
          <Button x:Name="BtnBurger" DockPanel.Dock="Left" Style="{StaticResource WinBtn}"
                  Width="42" Height="42" Click="Burger_Click" ToolTip="Collapse the menu">
            <Path Data="M 0,0 H 15 M 0,5.5 H 15 M 0,11 H 15" StrokeThickness="1.5"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                      Background="Transparent" Cursor="Hand" ToolTip="Show the introduction again"
                      MouseLeftButtonUp="Brand_Click">
            <!-- Même éclair que l'icône de l'application, en vectoriel : il reste
                 net à n'importe quelle échelle d'affichage. -->
            <Border Width="24" Height="24" CornerRadius="6" Background="#16212E"
                    BorderBrush="#2A3849" BorderThickness="1" VerticalAlignment="Center">
              <Path Data="M 13.6,1.8 L 3.4,13.9 H 10.2 L 9.2,22.2 L 20.6,9.4 H 13.1 Z"
                    Fill="{StaticResource Accent}" Stretch="Uniform" Width="12" Height="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Aeropeek" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="beta" Foreground="{StaticResource Ink3}" FontSize="11" Margin="8,3,0,0"/>
          </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
          <RadioButton x:Name="NavDiag" Style="{StaticResource Nav}" ToolTip="Diagnostics" local:NavIcon.Data="F1 M 3,12 A 9,9 0 1 1 21,12 A 9,9 0 1 1 3,12 Z M 12.9,12.9 L 17.3,6.7 L 11.1,11.1 Z" Content="Diagnostics"
                       IsChecked="True" Checked="Nav_Checked" Tag="0"/>
          <RadioButton x:Name="NavMatch" Style="{StaticResource Nav}" ToolTip="Match Mode" local:NavIcon.Data="F1 M 4.4,12 A 7.6,7.6 0 1 1 19.6,12 A 7.6,7.6 0 1 1 4.4,12 Z M 6.9,12 A 5.1,5.1 0 1 0 17.1,12 A 5.1,5.1 0 1 0 6.9,12 Z M 9.7,12 A 2.3,2.3 0 1 1 14.3,12 A 2.3,2.3 0 1 1 9.7,12 Z M 11.9,3 L 12.1,3 A 0.9,0.9 0 0 1 13,3.9 L 13,5.7 A 0.9,0.9 0 0 1 12.1,6.6 L 11.9,6.6 A 0.9,0.9 0 0 1 11,5.7 L 11,3.9 A 0.9,0.9 0 0 1 11.9,3 Z M 11.9,17.4 L 12.1,17.4 A 0.9,0.9 0 0 1 13,18.3 L 13,20.1 A 0.9,0.9 0 0 1 12.1,21 L 11.9,21 A 0.9,0.9 0 0 1 11,20.1 L 11,18.3 A 0.9,0.9 0 0 1 11.9,17.4 Z M 3.9,11 L 5.7,11 A 0.9,0.9 0 0 1 6.6,11.9 L 6.6,12.1 A 0.9,0.9 0 0 1 5.7,13 L 3.9,13 A 0.9,0.9 0 0 1 3,12.1 L 3,11.9 A 0.9,0.9 0 0 1 3.9,11 Z M 18.3,11 L 20.1,11 A 0.9,0.9 0 0 1 21,11.9 L 21,12.1 A 0.9,0.9 0 0 1 20.1,13 L 18.3,13 A 0.9,0.9 0 0 1 17.4,12.1 L 17.4,11.9 A 0.9,0.9 0 0 1 18.3,11 Z" Content="Match Mode"
                       Checked="Nav_Checked" Tag="4"/>
          <RadioButton x:Name="NavTweaks" Style="{StaticResource Nav}" ToolTip="Tweaks" local:NavIcon.Data="F1 M 5.5,3.5 L 5.5,3.5 A 1.3,1.3 0 0 1 6.8,4.8 L 6.8,19.2 A 1.3,1.3 0 0 1 5.5,20.5 L 5.5,20.5 A 1.3,1.3 0 0 1 4.2,19.2 L 4.2,4.8 A 1.3,1.3 0 0 1 5.5,3.5 Z M 2.4,8.5 A 3.1,3.1 0 1 1 8.6,8.5 A 3.1,3.1 0 1 1 2.4,8.5 Z M 4.25,8.5 A 1.25,1.25 0 1 0 6.75,8.5 A 1.25,1.25 0 1 0 4.25,8.5 Z M 12,3.5 L 12,3.5 A 1.3,1.3 0 0 1 13.3,4.8 L 13.3,19.2 A 1.3,1.3 0 0 1 12,20.5 L 12,20.5 A 1.3,1.3 0 0 1 10.7,19.2 L 10.7,4.8 A 1.3,1.3 0 0 1 12,3.5 Z M 8.9,15 A 3.1,3.1 0 1 1 15.1,15 A 3.1,3.1 0 1 1 8.9,15 Z M 10.75,15 A 1.25,1.25 0 1 0 13.25,15 A 1.25,1.25 0 1 0 10.75,15 Z M 18.5,3.5 L 18.5,3.5 A 1.3,1.3 0 0 1 19.8,4.8 L 19.8,19.2 A 1.3,1.3 0 0 1 18.5,20.5 L 18.5,20.5 A 1.3,1.3 0 0 1 17.2,19.2 L 17.2,4.8 A 1.3,1.3 0 0 1 18.5,3.5 Z M 15.4,7.5 A 3.1,3.1 0 1 1 21.6,7.5 A 3.1,3.1 0 1 1 15.4,7.5 Z M 17.25,7.5 A 1.25,1.25 0 1 0 19.75,7.5 A 1.25,1.25 0 1 0 17.25,7.5 Z" Content="Tweaks"
                       Checked="Nav_Checked" Tag="1"/>
          <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" ToolTip="Cleanup" local:NavIcon.Data="F1 M 20.4132,4.51317 L 14.2132,10.7132 L 12.5868,9.08683 L 18.7868,2.88683 Z M 10.8,7.6 L 16.4,13.2 L 11.4,21 L 3,12.6 Z M 7.95,9.55 L 14.45,16.05 L 15.15,15.35 L 8.65,8.85 Z" Content="Cleanup"
                       Checked="Nav_Checked" Tag="7"/>
          <RadioButton x:Name="NavDns" Style="{StaticResource Nav}" ToolTip="DNS" local:NavIcon.Data="F1 M 3,12 A 9,9 0 1 1 21,12 A 9,9 0 1 1 3,12 Z M 4.8,8.25 A 0.6,0.6 0 0 0 4.2,8.85 L 4.2,8.85 A 0.6,0.6 0 0 0 4.8,9.45 L 19.2,9.45 A 0.6,0.6 0 0 0 19.8,8.85 L 19.8,8.85 A 0.6,0.6 0 0 0 19.2,8.25 Z M 4.8,14.55 A 0.6,0.6 0 0 0 4.2,15.15 L 4.2,15.15 A 0.6,0.6 0 0 0 4.8,15.75 L 19.2,15.75 A 0.6,0.6 0 0 0 19.8,15.15 L 19.8,15.15 A 0.6,0.6 0 0 0 19.2,14.55 Z M 12,3.6 A 0.65,0.65 0 0 0 11.35,4.25 L 11.35,19.75 A 0.65,0.65 0 0 0 12,20.4 L 12,20.4 A 0.65,0.65 0 0 0 12.65,19.75 L 12.65,4.25 A 0.65,0.65 0 0 0 12,3.6 Z" Content="DNS"
                       Checked="Nav_Checked" Tag="6"/>
          <RadioButton x:Name="NavBench" Style="{StaticResource Nav}" ToolTip="Benchmark" local:NavIcon.Data="F1 M 3.95,19.1 L 20.05,19.1 A 0.95,0.95 0 0 1 21,20.05 L 21,20.05 A 0.95,0.95 0 0 1 20.05,21 L 3.95,21 A 0.95,0.95 0 0 1 3,20.05 L 3,20.05 A 0.95,0.95 0 0 1 3.95,19.1 Z M 6.5,11.8 L 7.9,11.8 A 1.1,1.1 0 0 1 9,12.9 L 9,19.2 A 1.1,1.1 0 0 1 7.9,20.3 L 6.5,20.3 A 1.1,1.1 0 0 1 5.4,19.2 L 5.4,12.9 A 1.1,1.1 0 0 1 6.5,11.8 Z M 11.3,5.6 L 12.7,5.6 A 1.1,1.1 0 0 1 13.8,6.7 L 13.8,19.2 A 1.1,1.1 0 0 1 12.7,20.3 L 11.3,20.3 A 1.1,1.1 0 0 1 10.2,19.2 L 10.2,6.7 A 1.1,1.1 0 0 1 11.3,5.6 Z M 16.1,14.3 L 17.5,14.3 A 1.1,1.1 0 0 1 18.6,15.4 L 18.6,19.2 A 1.1,1.1 0 0 1 17.5,20.3 L 16.1,20.3 A 1.1,1.1 0 0 1 15,19.2 L 15,15.4 A 1.1,1.1 0 0 1 16.1,14.3 Z" Content="Benchmark"
                       Checked="Nav_Checked" Tag="3"/>
          <RadioButton x:Name="NavUtils" Style="{StaticResource Nav}" ToolTip="Utilities" local:NavIcon.Data="F1 M 5.2,8.4 L 18.8,8.4 A 2.2,2.2 0 0 1 21,10.6 L 21,18.4 A 2.2,2.2 0 0 1 18.8,20.6 L 5.2,20.6 A 2.2,2.2 0 0 1 3,18.4 L 3,10.6 A 2.2,2.2 0 0 1 5.2,8.4 Z M 9.7,3.6 L 14.3,3.6 A 2.1,2.1 0 0 1 16.4,5.7 L 16.4,7.5 A 2.1,2.1 0 0 1 14.3,9.6 L 9.7,9.6 A 2.1,2.1 0 0 1 7.6,7.5 L 7.6,5.7 A 2.1,2.1 0 0 1 9.7,3.6 Z M 11,5.5 A 1.5,1.5 0 0 0 9.5,7 L 9.5,8.1 A 1.5,1.5 0 0 0 11,9.6 L 13,9.6 A 1.5,1.5 0 0 0 14.5,8.1 L 14.5,7 A 1.5,1.5 0 0 0 13,5.5 Z M 5.85,12.6 A 0.85,0.85 0 0 0 5,13.45 L 5,13.45 A 0.85,0.85 0 0 0 5.85,14.3 L 18.15,14.3 A 0.85,0.85 0 0 0 19,13.45 L 19,13.45 A 0.85,0.85 0 0 0 18.15,12.6 Z" Content="Utilities"
                       Checked="Nav_Checked" Tag="8"/>
          <RadioButton x:Name="NavRestore" Style="{StaticResource Nav}" ToolTip="Restore" local:NavIcon.Data="F1 M 17.2947,5.22311 A 8.6,8.6 0 1 1 7.19094,4.87028 L 9.0922,7.689 A 5.2,5.2 0 1 0 15.2014,7.90234 Z M 18.7107,3.41068 L 11.8352,3.11502 L 13.7854,9.71477 Z" Content="Restore"
                       Checked="Nav_Checked" Tag="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" x:Name="SysPanel">
          <Border Background="#0E1822" CornerRadius="7" Padding="13,11">
            <StackPanel>
              <TextBlock x:Name="SysCpu" Style="{StaticResource Sub}" FontSize="12"/>
              <TextBlock x:Name="SysGpu" Style="{StaticResource Sub}" FontSize="12" Margin="0,3,0,0"/>
              <TextBlock x:Name="SysOs"  Style="{StaticResource Sub}" FontSize="12" Margin="0,3,0,0"/>
              <TextBlock x:Name="SysAc"  Style="{StaticResource Sub}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Contenu -->
    <Grid Grid.Column="1">

      <!-- Diagnostic -->
      <Grid x:Name="ViewDiag" Margin="30,26,30,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
          <Button DockPanel.Dock="Right" x:Name="BtnScan" Content="Scan" Style="{StaticResource Primary}"
                  Click="Scan_Click" VerticalAlignment="Bottom"/>
          <StackPanel>
            <TextBlock Text="Diagnostics" Style="{StaticResource H1}"/>
            <TextBlock x:Name="DiagSummary" Style="{StaticResource Sub}" Margin="0,4,0,0"
                       Text="Reading your configuration…"/>
          </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
         <StackPanel>
          <ItemsControl x:Name="ChecksList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Background="{Binding BadgeBg}" CornerRadius="4"
                              Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}"
                                   FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{Binding BadgeFg}"
                                 FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" Margin="0,9,0,0"/>
                    <Border Visibility="{Binding AdviceVisibility}" Background="#0D1620" CornerRadius="6"
                            Padding="13,11" Margin="0,11,0,0">
                      <TextBlock Text="{Binding Advice}" Style="{StaticResource Sub}" Foreground="#A9BCCF"/>
                    </Border>
                    <Button Content="{Binding ActionLabel}" Style="{StaticResource Ghost}"
                            Visibility="{Binding ActionVisibility}" Tag="{Binding ActionId}"
                            Click="CheckAction_Click" HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="140"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="DiagVeil" Grid.Row="1" Style="{StaticResource ScanVeil}"
                        Content="Scanning the system…"/>
      </Grid>

      <!-- Reglages -->
      <Grid x:Name="ViewTweaks" Margin="30,26,30,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
          <TextBlock Text="Tweaks" Style="{StaticResource H1}"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                     Text="Every tweak records the exact state that came before it. Undoing restores that state — never a guessed default."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
          <ItemsControl x:Name="TweaksList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}">
                  <DockPanel>
                    <!-- Colonne de droite : largeur fixe et calage en haut, sinon la
                         presence du bouton Mesurer decale l'interrupteur en hauteur
                         comme en largeur, et les cartes ne s'alignent plus entre elles. -->
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Width="104" Margin="22,0,4,0">
                      <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Center"
                                    Margin="0,-2,0,0"
                                    IsChecked="{Binding IsOn, Mode=OneTime}" IsEnabled="{Binding ActionEnabled}"
                                    Tag="{Binding}" Click="Tweak_Click" ToolTip="{Binding ActionLabel}"/>
                      <TextBlock Text="{Binding StateLabel}" Foreground="{Binding BadgeFg}" FontSize="11"
                                 HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap"/>
                      <Button Content="Measure" Style="{StaticResource Ghost}" Height="28" Padding="12,0"
                              FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"
                              Visibility="{Binding MeasureVisibility}" Tag="{Binding}" Click="Measure_Click"
                              ToolTip="Measure what this tweak actually does on your machine"/>
                    </StackPanel>
                    <StackPanel>
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Background="{Binding BadgeBg}" CornerRadius="4"
                                Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}"
                                     FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Explanation}" Style="{StaticResource Sub}" Margin="0,9,0,0"/>
                      <TextBlock Text="{Binding Footnote}" Style="{StaticResource Sub}"
                                 Foreground="{StaticResource Ink3}" FontSize="12" Margin="0,7,0,0"/>
                      <Border Visibility="{Binding MeasuredVisibility}" Background="{Binding MeasuredBg}"
                              CornerRadius="6" Padding="11,7" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Measured}" Foreground="{Binding MeasuredFg}"
                                   FontSize="12.5" FontWeight="SemiBold"/>
                      </Border>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- DNS -->
      <Grid x:Name="ViewDns" Margin="30,26,30,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
          <Button DockPanel.Dock="Right" x:Name="BtnDnsTest" Content="Test the servers"
                  Style="{StaticResource Primary}" Click="DnsTest_Click" VerticalAlignment="Bottom"
                  Height="38" Padding="18,0" FontSize="13.5"/>
          <StackPanel>
            <TextBlock Text="DNS" Style="{StaticResource H1}"/>
            <TextBlock x:Name="DnsSummary" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
          <StackPanel>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="CURRENT SETUP" Style="{StaticResource Kicker}"/>
                <ItemsControl x:Name="AdaptersList" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Source}" Style="{StaticResource Sub}"
                                   FontSize="12" TextWrapping="NoWrap" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Servers}" Foreground="{StaticResource Accent}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="NoWrap"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8"
                                Background="#132A29" Margin="0,0,12,0" VerticalAlignment="Center">
                          <Path Data="{Binding Icon}" Width="19" Height="19" Stretch="Uniform"
                                Stroke="{StaticResource Accent}" StrokeThickness="1.6" Fill="Transparent"
                                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Kind}" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,1,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>


            <ItemsControl x:Name="DnsList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{Binding Border}"
                          BorderThickness="1" CornerRadius="9" Margin="0,0,12,12" Padding="18,16">
                    <Border.RenderTransform>
                      <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" Foreground="{Binding LatencyFg}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9"
                                Background="{Binding Tint}" Margin="0,0,12,0" VerticalAlignment="Center">
                          <Path Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                                Stroke="{Binding Accent}" StrokeThickness="1.7" Fill="Transparent"
                                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Addresses}" Foreground="{Binding Accent}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,12,0,0" Opacity="0.85"/>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,8,0,0"/>
                      <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Style="{StaticResource TintBtn}"
                                Background="{Binding Tint}" BorderBrush="{Binding Accent}" Foreground="{Binding Accent}"
                                IsEnabled="{Binding CanApply}" Tag="{Binding}" Click="DnsApply_Click" MinWidth="92"/>
                        <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#16212E" CornerRadius="4" Padding="7,3" Margin="0,0,6,0"
                                      BorderBrush="#22303F" BorderThickness="1">
                                <TextBlock Text="{Binding}" Foreground="#93A6BB" FontSize="11"/>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                      <Setter TargetName="card" Property="Background" Value="#16222F"/>
                      <Setter TargetName="card" Property="BorderBrush" Value="{Binding Accent}"/>
                      <Trigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="card"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="-3" Duration="0:0:0.14">
                              <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                              </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.EnterActions>
                      <Trigger.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="card"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.14"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.ExitActions>
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" x:Name="BtnCustomDns" Content="Show"
                          Style="{StaticResource Ghost}" Height="30" MinWidth="92" Click="CustomDns_Toggle"/>
                  <Border Width="36" Height="36" CornerRadius="9" Background="#231C36"
                          Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="M 9,12 A 3,3 0 1 0 15,12 A 3,3 0 1 0 9,12 M 12,2 V 5 M 12,19 V 22 M 4.2,6.6 L 6.3,8.7 M 17.7,15.3 L 19.8,17.4 M 2,12 H 5 M 19,12 H 22 M 4.2,17.4 L 6.3,15.3 M 17.7,8.7 L 19.8,6.6"
                          Width="20" Height="20" Stretch="Uniform" Fill="Transparent"
                          Stroke="#B98CF7" StrokeThickness="1.7"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Border>
                  <TextBlock Text="Custom servers" FontSize="15" FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel x:Name="CustomDnsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                  <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="PRIMARY SERVER" Style="{StaticResource Kicker}" Margin="0,0,0,7"/>
                      <TextBox x:Name="CustomPrimary" Tag="1.1.1.1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="SECONDARY SERVER (OPTIONAL)" Style="{StaticResource Kicker}" Margin="0,0,0,7"/>
                      <TextBox x:Name="CustomSecondary" Tag="1.0.0.1"/>
                    </StackPanel>
                  </Grid>
                  <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource Primary}"
                            Height="38" Padding="20,0" FontSize="13.5" Click="CustomDns_Apply" Margin="16,0,0,0"/>
                    <TextBlock x:Name="CustomDnsHint" Style="{StaticResource Sub}" FontSize="12.5"
                               VerticalAlignment="Center"
                               Text="IPv4 addresses only. The secondary one may stay empty."/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="DnsVeil" Grid.Row="1" Style="{StaticResource ScanVeil}"
                        Content="Testing the servers…"/>
      </Grid>

      <!-- Nettoyage -->
      <Grid x:Name="ViewClean" Margin="30,26,30,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" x:Name="BtnCleanRun" Content="Clean selected"
                  Style="{StaticResource Primary}" Click="CleanRun_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
          <Button DockPanel.Dock="Right" x:Name="BtnCleanScan" Content="Scan"
                  Style="{StaticResource Ghost}" Height="40" Click="CleanScan_Click" VerticalAlignment="Bottom"
                  Margin="10,0,0,0"/>
          <Button DockPanel.Dock="Right" x:Name="BtnCleanAll" Content="Select all"
                  Style="{StaticResource Ghost}" Height="40" Click="CleanAll_Click" VerticalAlignment="Bottom"
                  MinWidth="150"/>
          <StackPanel>
            <TextBlock Text="Cleanup" Style="{StaticResource H1}"/>
            <TextBlock x:Name="CleanSummary" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="#0F1923">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" x:Name="CleanSelected" Foreground="{StaticResource Accent}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="NoWrap" Margin="16,0,0,0"/>
            <TextBlock Style="{StaticResource Sub}" FontSize="12.5" VerticalAlignment="Center"
                       Text="Deleting files cannot be undone: moving tens of gigabytes into quarantine would make no sense. The journal keeps a record of it, but “Undo everything” will not bring them back."/>
          </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
          <ItemsControl x:Name="CleanList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected, Mode=TwoWay}"
                              Tag="{Binding}" Click="CleanToggle_Click" IsEnabled="{Binding Available}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{Binding SizeFg}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="NoWrap" Width="86" TextAlignment="Right"/>
                    <Border DockPanel.Dock="Right" Background="Transparent" BorderBrush="{Binding RiskBd}"
                            BorderThickness="1" CornerRadius="4" Padding="7,2"
                            VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding RiskVisibility}">
                      <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskFg}"
                                 FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ContentControl x:Name="CleanScanVeil" Style="{StaticResource ScanVeil}"
                        Content="Scanning folders…"/>
        </Grid>
      </Grid>

      <!-- Mode Match -->
      <Grid x:Name="ViewMatch" Margin="30,26,30,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
          <TextBlock Text="Match Mode" Style="{StaticResource H1}"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                     Text="Pauses what runs in the background for the length of a match, then puts everything back. No startup type is changed."/>
        </StackPanel>

        <!-- Bandeau compact. Les descriptions des deux options sont passées en
             infobulle : elles se lisent une fois et coûtaient trois lignes chacune. -->
        <Border Grid.Row="1" x:Name="MatchHero" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Width="84" VerticalAlignment="Center" Margin="18,0,0,0">
                <ToggleButton x:Name="SwMatch" Style="{StaticResource Switch}" HorizontalAlignment="Center"
                              Click="Match_Click" ToolTip="Turn on or off now"/>
                <TextBlock x:Name="MatchState" Text="Idle" Foreground="{StaticResource Ink3}"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="NoWrap"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MatchTitle" Text="Match Mode idle" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="MatchDetail" Style="{StaticResource Sub}" FontSize="12.5"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>

            <Border Height="1" Background="#1C2836" Margin="0,13,0,11"/>

            <DockPanel>
              <TextBlock DockPanel.Dock="Right" x:Name="HowLink" Text="How does it work?"
                         Foreground="{StaticResource Accent}" FontSize="12" Cursor="Hand"
                         Background="Transparent" Padding="4,2"
                         VerticalAlignment="Center" Margin="12,0,0,0" MouseLeftButtonUp="How_Click"/>
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ChkAuto" Style="{StaticResource SwitchSm}" Click="Option_Toggle"
                              VerticalAlignment="Center"
                              ToolTip="Turns itself on when CS2 starts, and off when it closes."/>
                <TextBlock Text="Automatic when CS2 starts" FontSize="12.5" Margin="9,0,24,0"
                           Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                <ToggleButton x:Name="ChkPriority" Style="{StaticResource SwitchSm}" IsChecked="True"
                              Click="Option_Toggle" VerticalAlignment="Center"
                              ToolTip="Windows serves cs2.exe before anything else. No effect while the game isn't running."/>
                <TextBlock Text="High priority for CS2" FontSize="12.5" Margin="9,0,0,0"
                           Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Repliée par défaut : la séquence se lit une fois, puis elle encombre. -->
        <Border Grid.Row="2" x:Name="HowCard" Style="{StaticResource Card}"
                Background="#0F1923" Margin="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
            <UniformGrid Columns="3">
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Width="19" Height="19" CornerRadius="9.5" Background="#0F2A29" VerticalAlignment="Top">
                  <TextBlock Text="1" Foreground="{StaticResource Accent}" FontSize="11"
                             FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="Priority" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,0"
                             TextWrapping="Wrap" Text="cs2.exe goes first."/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Width="19" Height="19" CornerRadius="9.5" Background="#0F2A29" VerticalAlignment="Top">
                  <TextBlock Text="2" Foreground="{StaticResource Accent}" FontSize="11"
                             FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="Applications" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,0"
                             TextWrapping="Wrap" Text="Ticked ones get closed."/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Width="19" Height="19" CornerRadius="9.5" Background="#0F2A29" VerticalAlignment="Top">
                  <TextBlock Text="3" Foreground="{StaticResource Accent}" FontSize="11"
                             FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="Services" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Margin="0,2,0,0"
                             TextWrapping="Wrap" Text="Ticked ones get suspended."/>
                </StackPanel>
              </StackPanel>
            </UniformGrid>
            <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="Turning it off puts everything back: services restarted, applications reopened, priority handed back. No startup type is changed — and if Aeropeek closes abruptly, the rollback happens on the next launch."/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Margin="0,14,0,0">
         <StackPanel>

          <DockPanel Margin="2,2,0,10">
            <Button DockPanel.Dock="Right" x:Name="BtnSelectApps" Content="Tick all"
                    Style="{StaticResource Ghost}" Height="26" Padding="12,0" FontSize="11.5"
                    Click="SelectAllApps_Click" VerticalAlignment="Center"/>
            <TextBlock x:Name="AppsHeader" Text="BACKGROUND APPLICATIONS"
                       Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl x:Name="AppsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}"
                        ToolTip="{Binding Note}">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected, Mode=TwoWay}"
                              Tag="{Binding}" Click="App_Toggle"
                              VerticalAlignment="Center" Margin="0,0,13,0"/>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                                MinWidth="88">
                      <TextBlock Text="{Binding Memory}" Foreground="{Binding ActivityFg}" FontSize="12.5"
                                 FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas"
                                 HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding Cpu}" Style="{StaticResource Sub}" FontSize="11"
                                 HorizontalAlignment="Right" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#16212E" CornerRadius="4" Padding="7,2"
                            Margin="14,0,0,0" BorderBrush="#22303F" BorderThickness="1"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Category}" Foreground="#8FA4BA" FontSize="11"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" FontSize="12"
                                 Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="NoAppsText" Style="{StaticResource Sub}" Margin="2,0,0,12"
                     Visibility="Collapsed"
                     Text="None of the applications it knows about are running right now."/>

          <DockPanel Margin="2,10,0,10">
            <Button DockPanel.Dock="Right" x:Name="BtnResample" Content="Refresh"
                    Style="{StaticResource Ghost}" Height="26" Padding="12,0" FontSize="11.5"
                    Click="Resample_Click" Margin="10,0,0,0" VerticalAlignment="Center"
                    ToolTip="Re-measure for 5 seconds what each service consumes"/>
            <Button DockPanel.Dock="Right" x:Name="BtnSelectAll" Content="Tick all"
                    Style="{StaticResource Ghost}" Height="26" Padding="12,0" FontSize="11.5"
                    Click="SelectAll_Click" VerticalAlignment="Center"/>
            <TextBlock x:Name="ServicesHeader" Text="WINDOWS SERVICES"
                       Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl x:Name="ServicesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}"
                        ToolTip="{Binding Note}">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected, Mode=TwoWay}"
                              Tag="{Binding}" Click="Service_Toggle"
                              VerticalAlignment="Center" Margin="0,0,13,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Activity}" Foreground="{Binding ActivityFg}"
                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextWrapping="NoWrap" Margin="14,0,0,0"/>
                    <Border DockPanel.Dock="Right" Background="Transparent" BorderBrush="{Binding ImpactBd}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="7,2" Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Impact}" Foreground="{Binding ImpactFg}"
                                 FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock FontSize="14" FontWeight="SemiBold">
                        <Run Text="{Binding Label, Mode=OneWay}"/>
                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Ink3}"
                             FontSize="11.5" FontWeight="Normal" FontFamily="Cascadia Mono, Consolas"/>
                      </TextBlock>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" FontSize="12"
                                 Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="IdleLink" Foreground="{StaticResource Accent}" FontSize="12.5" Cursor="Hand"
                     Background="Transparent" Padding="4,3" HorizontalAlignment="Left"
                     Margin="0,4,0,8" MouseLeftButtonUp="ShowIdle_Click"/>

         </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="MatchVeil" Grid.Row="3" Style="{StaticResource ScanVeil}"
                        Content="Applying…"/>
      </Grid>

      <!-- Benchmark -->
      <Grid x:Name="ViewBench" Margin="30,26,30,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" x:Name="BtnCapture" Content="Capture 60 s"
                  Style="{StaticResource Primary}" Click="Capture_Click" VerticalAlignment="Bottom"/>
          <StackPanel>
            <TextBlock Text="Benchmark" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                       Text="Measures frame times while you play, so you can compare before and after a tweak."/>
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="Name for this run" Style="{StaticResource Sub}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock x:Name="BenchStatus" DockPanel.Dock="Right" Style="{StaticResource Sub}"
                       VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="NoWrap"/>
            <TextBox x:Name="BenchLabel" Text="before tweak" Height="34" VerticalContentAlignment="Center"
                     Background="#0D1620" Foreground="{StaticResource Ink}" BorderBrush="#2A3849"
                     BorderThickness="1" Padding="10,0" CaretBrush="{StaticResource Accent}"/>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Margin="0,4,0,0">
         <StackPanel>

          <Border x:Name="ChartCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="16" Height="2.5" CornerRadius="1" Background="#C27C14" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ChartOldLabel" Style="{StaticResource Sub}" FontSize="12.5"
                             Margin="8,0,18,0" TextWrapping="NoWrap"/>
                  <Border Width="16" Height="2.5" CornerRadius="1" Background="#0EA595" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ChartNewLabel" Style="{StaticResource Sub}" FontSize="12.5"
                             Margin="8,0,0,0" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Frame time" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="lower and flatter is better" Style="{StaticResource Sub}"
                             FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Canvas x:Name="ChartAxis" Grid.Column="0" Height="200"/>
                <Canvas x:Name="ChartArea" Grid.Column="1" Height="200" ClipToBounds="True"
                        Background="Transparent" SizeChanged="Chart_SizeChanged"/>
              </Grid>

              <TextBlock x:Name="ChartFootnote" Style="{StaticResource Sub}" FontSize="12"
                         Foreground="{StaticResource Ink3}" Margin="46,10,0,0"/>
            </StackPanel>
          </Border>

          <ItemsControl x:Name="BenchList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardItem}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Sub}"
                                 FontSize="12" TextWrapping="NoWrap" Margin="12,0,0,0"/>
                      <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"/>
                    </DockPanel>
                    <UniformGrid Columns="5">
                      <StackPanel>
                        <TextBlock Text="Average FPS" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding Fps}" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="1% low" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding Low1}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"
                                   FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="0.1% low" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding Low01}" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Slowest frame" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding MaxMs}" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Stutters" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding Stutters}" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0"/>
                      </StackPanel>
                    </UniformGrid>
                    <Border Visibility="{Binding DeltaVisibility}" Background="#0D1620" CornerRadius="6"
                            Padding="13,10" Margin="0,14,0,0">
                      <TextBlock Text="{Binding Delta}" Foreground="{Binding DeltaFg}" FontSize="13"/>
                    </Border>
                    <TextBlock Text="{Binding Footnote}" Style="{StaticResource Sub}"
                               Foreground="{StaticResource Ink3}" FontSize="12" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

         </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Utilitaires -->
      <Grid x:Name="ViewUtils" Margin="30,26,30,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
          <TextBlock Text="Utilities" Style="{StaticResource H1}"/>
          <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                     Text="Windows' own tools, gathered in one place. They act on their own: Aeropeek launches them and shows their output, without journalling them or pretending it can undo them."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
          <ItemsControl x:Name="UtilsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}"
                            Style="{StaticResource TintBtn}" Background="{Binding Tint}"
                            BorderBrush="{Binding Accent}" Foreground="{Binding Accent}"
                            Tag="{Binding}" Click="Utility_Click"
                            VerticalAlignment="Center" MinWidth="104" Margin="18,0,0,0"/>
                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10"
                            Background="{Binding Tint}" Margin="0,0,14,0" VerticalAlignment="Center">
                      <Path Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Fill="Transparent"
                            Stroke="{Binding Accent}" StrokeThickness="1.7"
                            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#16212E" CornerRadius="4" Padding="7,2" Margin="11,0,0,0"
                                BorderBrush="#22303F" BorderThickness="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Display}" Foreground="#8FA4BA" FontSize="11"
                                     FontFamily="Cascadia Mono, Consolas"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                      <TextBlock Text="{Binding Caution}" Visibility="{Binding CautionVisibility}"
                                 Foreground="#E0A63C" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Restauration : les deux facons de revenir en arriere, cote a cote.
           Les points systeme ramenent toute la machine ; le journal defait un
           reglage precis. Ni l'un ni l'autre ne remplace le second. -->
      <Grid x:Name="ViewRestore" Margin="30,26,30,20" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
          <Border DockPanel.Dock="Right" Background="#0E1822" CornerRadius="9" Padding="3"
                  VerticalAlignment="Bottom" BorderBrush="#1C2836" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TabPoints" Style="{StaticResource Pill}" GroupName="Restore"
                           Content="System points" IsChecked="True" Checked="RestoreTab_Checked" Tag="points"/>
              <RadioButton x:Name="TabJournal" Style="{StaticResource Pill}" GroupName="Restore"
                           Content="Change journal" Checked="RestoreTab_Checked" Tag="journal"/>
            </StackPanel>
          </Border>
          <StackPanel>
            <TextBlock Text="Restore" Style="{StaticResource H1}"/>
            <TextBlock x:Name="RestoreSub" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">

          <Grid x:Name="PanePoints">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}">
          <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="BtnRestoreCreate" Content="Create a point"
                    Style="{StaticResource Primary}" Click="RestoreCreate_Click"
                    VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="BtnRestoreReload" Content="Refresh"
                    Style="{StaticResource Ghost}" Height="40" Click="RestoreReload_Click"
                    VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="RestoreState" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="RestoreDetail" Style="{StaticResource Sub}" FontSize="12.5"
                         Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" x:Name="RestoreFix" Style="{StaticResource Card}"
                Background="#2B2317" BorderBrush="#5A4A20" Margin="0,0,0,12" Visibility="Collapsed">
          <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="BtnRestoreFix" Style="{StaticResource Ghost}"
                    Click="RestoreFix_Click" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="150"/>
            <TextBlock x:Name="RestoreFixText" Foreground="#E0A63C" FontSize="12.5"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
         <StackPanel>
          <DockPanel Margin="2,0,0,10">
            <TextBlock DockPanel.Dock="Right" x:Name="DeleteAllLink" Text="Delete all"
                       Foreground="#F2726A" FontSize="12.5" Cursor="Hand" Background="Transparent"
                       Padding="4,3" VerticalAlignment="Center" MouseLeftButtonUp="RestoreDeleteAll_Click"/>
            <TextBlock x:Name="RestoreHeader" Text="AVAILABLE POINTS"
                       Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
          </DockPanel>

          <ItemsControl x:Name="RestoreList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource Ghost}"
                            Height="30" Padding="12,0" FontSize="12" Tag="{Binding}"
                            Click="RestoreDelete_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Restore" Style="{StaticResource TintBtn}"
                            Background="#16212E" BorderBrush="{StaticResource Accent}"
                            Foreground="{StaticResource Accent}" Height="30" Padding="14,0" FontSize="12"
                            Tag="{Binding}" Click="RestoreApply_Click" VerticalAlignment="Center"
                            Margin="14,0,0,0"/>
                    <Border DockPanel.Dock="Right" Background="#16212E" CornerRadius="4" Padding="7,2"
                            Margin="14,0,0,0" BorderBrush="#22303F" BorderThickness="1"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Type}" Foreground="#8FA4BA" FontSize="11"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding When}" Style="{StaticResource Sub}" FontSize="12"
                                 Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="RestoreEmpty" Style="{StaticResource Sub}" Margin="2,4,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed"/>
         </StackPanel>
        </ScrollViewer>

            <ContentControl x:Name="RestoreVeil" Grid.Row="2" Style="{StaticResource ScanVeil}"
                            Content="Reading restore points…"/>
          </Grid>

          <Grid x:Name="PaneJournal" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
              <Button DockPanel.Dock="Right" Content="Undo everything" Style="{StaticResource Ghost}"
                      Height="32" Padding="14,0" FontSize="12.5" Click="RevertAll_Click"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
              <Button DockPanel.Dock="Right" Content="Export the diagnostics" Style="{StaticResource Ghost}"
                      Height="32" Padding="14,0" FontSize="12.5" Click="Export_Click"
                      VerticalAlignment="Center"/>
              <TextBlock x:Name="JournalSummary" Style="{StaticResource Sub}" FontSize="12.5"
                         VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
          <ItemsControl x:Name="JournalList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardAction}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Undo" Style="{StaticResource Ghost}"
                            Height="30" Padding="14,0" FontSize="12" Tag="{Binding}"
                            Click="JournalUndo_Click" VerticalAlignment="Center" Margin="14,0,0,0"
                            Visibility="{Binding UndoVisibility}"
                            ToolTip="Put back the exact state that came before"/>
                    <TextBlock DockPanel.Dock="Right" Text="Permanent" Foreground="{StaticResource Ink3}"
                               FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextWrapping="NoWrap" Visibility="{Binding NoUndoVisibility}"
                               ToolTip="This operation cannot be undone"/>
                  <StackPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Sub}"
                                 FontSize="12" TextWrapping="NoWrap" Margin="12,0,0,0"/>
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Sub}" FontSize="12"
                               FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Change}" Style="{StaticResource Sub}" FontSize="12" Margin="0,4,0,0"/>
                  </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>

    </Grid>
  </Grid>

  <!-- Accueil : recouvre toute la fenêtre au premier lancement -->
  <!-- Ligne 1 seulement : la barre de titre reste utilisable par-dessus -->
  <Border x:Name="Welcome" Grid.Row="1" Background="{StaticResource Bg}"
          Visibility="Collapsed">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="40,56,40,48">

        <TextBlock Text="Aeropeek" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" FontSize="15" TextWrapping="Wrap"
                   Text="A tuning tool for CS2 that measures instead of promising."/>

        <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,30,0,0">
          <StackPanel>
            <TextBlock Text="WHAT IT DOES DIFFERENTLY" Style="{StaticResource Kicker}"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <TextBlock Text="—" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,12,0"/>
              <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" FontSize="14"
                         Text="It tells you when a tweak does nothing. Most “optimizations” going around change nothing measurable, and Aeropeek says so instead of selling them to you."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock Text="—" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,12,0"/>
              <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" FontSize="14"
                         Text="Everything it changes is recorded, along with the exact prior state. The Restore tab puts it all back the way it was, even weeks later."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock Text="—" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,0,12,0"/>
              <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" FontSize="14"
                         Text="It does not disable your antivirus, does not touch Windows Update and deletes no system file. Those paths are forbidden in the code, not merely discouraged."/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="WHERE TO START" Style="{StaticResource Kicker}" Margin="2,30,0,12"/>

        <Border Style="{StaticResource Card}" Padding="22,18">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="1" Foreground="{StaticResource Accent}"
                       FontSize="26" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas"
                       Margin="0,0,20,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,5,0,0" TextWrapping="Wrap"
                         Text="Run the scan. It changes nothing, and tells you what is actually wrong with this machine."/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,10,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="2" Foreground="{StaticResource Accent}"
                       FontSize="26" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas"
                       Margin="0,0,20,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Benchmark" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,5,0,0" TextWrapping="Wrap"
                         Text="Measure a match before touching anything at all. Without that starting point, no tweak can be judged."/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,10,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="3" Foreground="{StaticResource Accent}"
                       FontSize="26" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas"
                       Margin="0,0,20,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="One change at a time" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Sub}" Margin="0,5,0,0" TextWrapping="Wrap"
                         Text="Apply one tweak, play again, measure again. Applying ten at once makes it impossible to know which one helped — and often none of them did."/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Background="#0D1620" CornerRadius="6" Padding="16,14" Margin="0,22,0,0">
          <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" FontSize="12.5" Foreground="#A9BCCF"
                     Text="Aeropeek runs as administrator because it reads and writes system settings. It sends nothing over the internet and collects no data: everything it writes stays in your own user folder."/>
        </Border>

        <Button x:Name="BtnWelcomeStart" Content="Run the diagnostics" Style="{StaticResource Primary}"
                Click="WelcomeStart_Click" HorizontalAlignment="Left" Margin="0,26,0,0" MinWidth="210"/>

      </StackPanel>
    </ScrollViewer>
  </Border>

  </Grid>
</Window>
