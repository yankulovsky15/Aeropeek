<Window x:Class="Aeropeek.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

  <Border Background="{StaticResource Surface}" BorderBrush="#26374A" BorderThickness="1"
          CornerRadius="12" Margin="14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
    </Border.Effect>

    <Grid Margin="26,24,26,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0">
        <Border DockPanel.Dock="Left" x:Name="IconPill" Width="38" Height="38" CornerRadius="10"
                Background="#16223A" Margin="0,0,14,0" VerticalAlignment="Top">
          <Path x:Name="IconPath" Width="21" Height="21" Stretch="Uniform" Fill="Transparent"
                Stroke="#6BA6F5" StrokeThickness="1.7"
                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
      </DockPanel>

      <TextBlock Grid.Row="1" x:Name="MessageText" Style="{StaticResource Sub}" FontSize="13.5"
                 Margin="52,14,0,0" LineHeight="21"/>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
        <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource Ghost}" Height="38"
                MinWidth="104" Margin="0,0,10,0" Click="Cancel_Click" Visibility="Collapsed"/>
        <Button x:Name="BtnOk" Content="OK" Style="{StaticResource Primary}" Height="38"
                MinWidth="104" Click="Ok_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
