<Application x:Class="Aeropeek.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aeropeek"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <SolidColorBrush x:Key="Bg"      Color="#0A1017"/>
    <SolidColorBrush x:Key="Surface" Color="#111B27"/>
    <SolidColorBrush x:Key="Hover"   Color="#17232F"/>
    <SolidColorBrush x:Key="Line"    Color="#1C2836"/>
    <SolidColorBrush x:Key="Ink"     Color="#E8EEF5"/>
    <SolidColorBrush x:Key="Ink2"    Color="#8497AC"/>
    <SolidColorBrush x:Key="Ink3"    Color="#4E6076"/>
    <SolidColorBrush x:Key="Accent"  Color="#2DD4BF"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Kicker" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Bouton principal -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#04211D"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.965" ScaleY="0.94"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton secondaire -->
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#CDDAE7"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6"
                    BorderBrush="#2A3849" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1A2635"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.965" ScaleY="0.94"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Entrée de navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#9DB0C4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="root" Height="42" RenderTransformOrigin="0.5,0.5">
              <!-- L'onglet s'enfonce sous le clic : c'est une transformation de
                   rendu, pas de disposition, donc les onglets voisins ne bougent
                   pas d'un pixel pendant que celui-ci se comprime. -->
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <!-- 12 px sur 42 de haut. A 7 px l'angle se voyait encore ; a 21 la
                   ligne serait devenue une pilule, ce qui n'est pas le genre du
                   reste de l'interface. -->
              <Border x:Name="b" Background="Transparent" CornerRadius="12"/>
              <!-- La pastille de l'onglet actif est une couche a part, et non une
                   couleur posee sur « b ». Une couleur venue d'un Setter change
                   d'un bloc ; une opacite, elle, s'anime. C'est ce saut-la qui
                   rendait le changement d'onglet sec, alors meme que la barre
                   turquoise en dessous, elle, glissait deja. -->
              <Border x:Name="sel" Background="{StaticResource Hover}" CornerRadius="12" Opacity="0"/>
              <!-- barre d'onglet actif, façon Windows 11 : elle grandit depuis le centre -->
              <Border x:Name="ind" Width="3" Height="0" CornerRadius="1.5"
                      Background="{StaticResource Accent}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"/>
              <StackPanel x:Name="row" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                <!-- Silhouettes pleines, dessinees sur une grille de 24 : a taille
                     egale, Stretch="Uniform" leur donne le meme poids optique.
                     Le remplissage NonZero est porte par le trace lui-meme (F1). -->
                <Path x:Name="ico" Width="19" Height="19" Stretch="Uniform"
                      Data="{Binding Path=(local:NavIcon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                      Fill="{TemplateBinding Foreground}" Stroke="{x:Null}"
                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Path.RenderTransform>
                </Path>
                <ContentPresenter x:Name="txt" VerticalAlignment="Center" Margin="13,0,0,0"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding CompactNav, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="txt" Property="Visibility" Value="Collapsed"/>
                <!-- La barre réduite ne laisse que 42 px utiles : les marges du
                     mode large écraseraient une icône de 19 px et la décaleraient
                     vers la gauche. On la recentre. -->
                <Setter TargetName="row" Property="Margin" Value="0"/>
                <Setter TargetName="row" Property="HorizontalAlignment" Value="Center"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#131F2B"/>
              </Trigger>
              <!-- Appui et detente. La compression est breve et sans ressort :
                   sous le doigt, la matiere cede tout de suite. C'est au
                   RELACHEMENT que le ressort agit, et il depasse legerement —
                   c'est ce depassement qu'on lit comme une detente, et non comme
                   un simple retour a la taille d'origine. -->
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="root"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.972" Duration="0:0:0.07"/>
                      <DoubleAnimation Storyboard.TargetName="root"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.90" Duration="0:0:0.07"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="root"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.9"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="root"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.9"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ico" Property="Fill" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <!-- Les trois animations partent ensemble et se terminent
                           presque ensemble : c'est ce qui les fait lire comme un
                           seul geste plutot que comme trois effets empiles. -->
                      <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.17">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="ind" Storyboard.TargetProperty="Height"
                                       To="18" Duration="0:0:0.20">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <!-- L'icone enfle depuis 0,86 avec le meme rebond que la
                           barre : le regard suit l'icone, la barre confirme. -->
                      <DoubleAnimation Storyboard.TargetName="ico"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       From="0.86" To="1" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="ico"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       From="0.86" To="1" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="ind" Storyboard.TargetProperty="Height"
                                       To="0" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Deux densites, et deux seulement : un bloc encadre un ecran, une ligne
         se repete dans une liste. Chaque ecran choisissait la sienne, ce qui
         donnait onze marges differentes pour la meme chose. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Ligne de liste : plus dense, et elle arrive en fondu quand la liste se
         remplit, pour qu'un rafraichissement se voie au lieu de sauter. -->
    <Style x:Key="CardItem" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                               Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                  <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <!-- Barre de defilement fine, sans fleches -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="#293747" CornerRadius="3" Margin="3,0"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#3B4E63"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="t" Property="Background" Value="#4A6076"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Champ de saisie. Le texte d'exemple se met dans Tag. -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1620"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                    BorderBrush="#2A3849" BorderThickness="1">
              <Grid>
                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="#4E6076"
                           FontSize="{TemplateBinding FontSize}" Visibility="Collapsed"
                           VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#3A4B5E"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Case à cocher -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="21" Height="21" CornerRadius="6"
                      Background="#0D1620" BorderBrush="#35465A" BorderThickness="1.5"
                      VerticalAlignment="Center">
                <Path x:Name="tick" Data="M 4,12.4 L 9.2,17.6 L 20,6.6" Stretch="Uniform" Margin="4.5"
                      Stroke="#04211D" StrokeThickness="3.2" Opacity="0"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Border>
              <ContentPresenter x:Name="lbl" VerticalAlignment="Center" Margin="11,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="lbl" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="#4A6076"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="box" Property="Background" Value="#101A24"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#243141"/>
                <Setter Property="Foreground" Value="#4E6076"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Carte porteuse d'une action : elle réagit au survol -->
    <!-- Ligne de liste sur laquelle on peut agir : le survol le montre. Les
         listes purement informatives gardent CardItem, sans survol trompeur. -->
    <Style x:Key="CardAction" TargetType="Border" BasedOn="{StaticResource CardItem}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#152131"/>
          <Setter Property="BorderBrush" Value="#2A3B4F"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Ligne cliquable dans une liste -->
    <Style x:Key="RowHover" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#14202C"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bouton teinte par la couleur du fournisseur -->
    <Style x:Key="TintBtn" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="6" Opacity="0"/>
              <Border x:Name="edge" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2"
                      CornerRadius="6" Opacity="0.5"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="edge" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.13"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.13"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                <Setter TargetName="edge" Property="Opacity" Value="1"/>
              </Trigger>
              <!-- désactivé = fournisseur déjà actif : on l'affiche rempli, pas grisé -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                <Setter TargetName="edge" Property="Opacity" Value="1"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sous-onglet segmente, pour partager un ecran entre deux volets. -->
    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="15,7">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#16212E"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#0F2A29"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interrupteur reduit, pour les options secondaires posees en ligne. -->
    <Style x:Key="SwitchSm" TargetType="ToggleButton">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="19"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="track" Background="#2A3849" CornerRadius="9.5" BorderThickness="0">
              <Ellipse x:Name="knob" Width="15" Height="15" Fill="#93A4B8"
                       HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="slide" X="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="Fill" Value="#FFFFFF"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X"
                                       To="15" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X"
                                       To="0" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interrupteur -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="track" Background="#2A3849" CornerRadius="13" BorderThickness="0">
              <Ellipse x:Name="knob" Width="20" Height="20" Fill="#93A4B8"
                       HorizontalAlignment="Left" Margin="3,0,0,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="slide" X="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="Fill" Value="#FFFFFF"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X"
                                       To="20" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X"
                                       To="0" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="knob" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="track" Property="Background" Value="#1A2330"/>
                <Setter TargetName="knob" Property="Fill" Value="#3A4B5E"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Boutons de fenetre -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="#9DB0C4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1A2635"/>
                <Setter Property="Foreground" Value="#E8EEF5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#C0392B"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Voile d'attente. Il s'anime tout seul des qu'il devient visible : aucun
         ecran n'a a piloter sa propre animation, il suffit de le montrer et de
         le cacher. Le texte affiche vient du Content. -->
    <Style x:Key="ScanVeil" TargetType="ContentControl">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Panel.ZIndex" Value="60"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border Background="#CC0A1017">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="220" Height="4" CornerRadius="2" Background="#16212E" ClipToBounds="True">
                  <Border x:Name="bar" Width="70" Height="4" CornerRadius="2"
                          Background="{StaticResource Accent}" HorizontalAlignment="Left">
                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                  </Border>
                </Border>
                <ContentPresenter HorizontalAlignment="Center" Margin="0,14,0,0"
                                  TextBlock.Foreground="{StaticResource Ink2}" TextBlock.FontSize="13"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="sweep">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bar"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       From="-70" To="220" Duration="0:0:0.95"
                                       RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="sweep"/>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
